	};

	spi2_pins_mx: spi2_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 14, AF2)>, /* SPI2_SCK */
					 <STM32_PINMUX('D', 12, AF2)>, /* SPI2_MISO */
					 <STM32_PINMUX('D', 13, AF2)>, /* SPI2_NSS */
					 <STM32_PINMUX('I', 9, AF2)>; /* SPI2_MOSI */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	tim2_pins_mx: tim2_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('A', 5, AF8)>, /* TIM2_CH4 */
					 <STM32_PINMUX('G', 5, AF7)>; /* TIM2_CH3 */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	tim2_pwm_pins_mx: tim2_pwm_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('F', 15, AF7)>, /* TIM2_CH2 */
					 <STM32_PINMUX('I', 7, AF7)>; /* TIM2_CH1 */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
